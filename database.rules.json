{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["trophies"],

      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','coins','trophies'])",

        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "trophies": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "diamonds": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "goals": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bestScore": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "losses": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "draws": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "skin": {
          ".validate": "newData.isString()"
        },
        "power": {
          ".validate": "newData.isString()"
        },
        "owned": {
          "$skinId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "ownedPowers": {
          "$powerId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",

        "host": {
          ".validate": "newData.isString()"
        },
        "guest": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'ready' || newData.val() === 'playing')"
        },
        "state": {
          ".validate": "newData.hasChildren(['s1','s2'])"
        },
        "inputs": {
          "$uid": {
            ".validate": "newData.hasChildren(['left','right','jump','shoot','pass','power'])"
          }
        }
      }
    }
  }
}